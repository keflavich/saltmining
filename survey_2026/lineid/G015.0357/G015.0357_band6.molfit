%============================================================================================================================
% XCLASS molfit for G326.6618+00.5207 (Brand "W22" hot core, 1.8 kpc, ~1.5e4 Lsun)
% Adapted from /orange/adamginsburg/w51/hotcores/linecatalog/ethanbhula/mm31_band6.molfit
% v_LSR = +19.2 km/s (RMS), peak T(spw33) ~366 K (hot dust + lines)
%
% Column 1: source size (arcsec) -- 100 = larger than beam (no beam dilution)
% Column 2: T_kin (K)            -- LTE excitation T; tune per molecule
% Column 3: N_tot (cm^-2)        -- total column
% Column 4: V_width (km/s)       -- intrinsic FWHM
% Column 5: V_off (km/s)         -- v_LSR offset; XCLASS expects velocity here
% Column 6: CFFlag               -- 63 = fit all 5 params
% Column 7: keyword              -- c = component identifier
%
% Start commented out and uncomment a few species at a time while iterating.
%============================================================================================================================
%    source size:                 T_kin:               N_tot:            V_width:                V_off:   CFFlag:    keyword:
%       [arcsec]:                   [K]:              [cm-2]:            [km /s]:              [km /s]:       []:         []:

% --- Strong COMs (always uncomment first) ---
CH3OH;v=0;           1
 100       270     1e+18     5    +19.2         c
CH3OCHO;v=0;           1
 100       90      5e+17     4    +19.2         c
CH3CN;v=0;           1
 100       300     1e+17     6    +19.2         c
CH3CN;v8=1;#1           1
 100       300     1.5e+17     7    +19.2         c

% --- Salts (the species we want to disentangle) ---
NaCl;v=0;           1
 100       450     5e+13     3    +19.2         c
NaCl;v=1;           1
 100       450     5e+13     3    +19.2         c
KCl;v=0;           1
 100       450     2e+13     3    +19.2         c
H2O;v2=1;           1
 100       2500    1e+15     5    +19.2         c

