%============================================================================================================================
% Comprehensive XCLASS molfit for the 215-260 GHz salt-search band.
% Species chosen to catch hot-core COMs + shock + ions that commonly blend
% near NaCl/KCl/SiS/H2O lines. Column densities are sample-averaged
% rough estimates for an unresolved hot-core; the goal is not to fit any
% one source but to generate a comprehensive transition_energies.dat for
% contaminant lookup.
%============================================================================================================================
%    source size:                 T_kin:               N_tot:            V_width:                V_off:   CFFlag:    keyword:
%       [arcsec]:                   [K]:              [cm-2]:            [km /s]:              [km /s]:       []:         []:

CH3OH;v=0;           1
 1       250     1e+18     5    0.0         c
CH3OH;v12=1;           1
 1       250     5e+17     5    0.0         c
CH3OCHO;v=0;           1
 1       100     5e+17     5    0.0         c
CH3OCHO;v18=1;           1
 1       150     2e+17     5    0.0         c
CH3OCH3;v=0;           1
 1       100     5e+17     5    0.0         c
CH3CN;v=0;           1
 1       250     5e+16     5    0.0         c
CH3CN;v8=1;#1           1
 1       300     5e+16     5    0.0         c
HC3N;v=0;           1
 1       200     1e+15     5    0.0         c
HC3N;v7=1;           1
 1       300     5e+14     5    0.0         c
C2H5CN;v=0;           1
 1       100     5e+15     5    0.0         c
NH2CHO;v=0;           1
 1       100     1e+15     5    0.0         c
NH2CHO;v12=1;           1
 1       150     5e+14     5    0.0         c
HCOOH;v=0;           1
 1       100     1e+15     5    0.0         c
HNCO;v=0;           1
 1       200     5e+15     5    0.0         c
H2CO;v=0;           1
 1       100     1e+16     5    0.0         c
H2CS;v=0;           1
 1       100     5e+14     5    0.0         c
H2S;v=0;           1
 1       100     1e+16     5    0.0         c
SO;v=0;           1
 1       100     1e+16     5    0.0         c
SO2;v=0;           1
 1       100     1e+16     5    0.0         c
OCS;v=0;           1
 1       100     5e+15     5    0.0         c
SiO;v=0;           1
 1       100     5e+13     5    0.0         c
SiS;v=0;           1
 1       100     5e+13     5    0.0         c
13CO;v=0;           1
 1       50      1e+17     5    0.0         c
C-18-O;v=0;           1
 1       50      5e+16     5    0.0         c
DCN;v=0;           1
 1       100     1e+14     5    0.0         c
DCO+;v=0;           1
 1       100     5e+13     5    0.0         c
CH3NH2;v=0;           1
 1       100     5e+15     5    0.0         c
H2O;v2=1;           1
 1       3000    5e+15     5    0.0         c
NaCl;v=0;           1
 1       400     5e+13     3    0.0         c
NaCl;v=1;           1
 1       400     5e+13     3    0.0         c
NaCl;v=2;           1
 1       400     5e+13     3    0.0         c
KCl;v=0;           1
 1       400     2e+13     3    0.0         c
KCl;v=1;           1
 1       400     2e+13     3    0.0         c
